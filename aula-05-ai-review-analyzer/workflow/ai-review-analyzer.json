    {
      "parameters": {
        "jsCode": "const openai = $input.first().json;\nconst resposta = openai.choices?.[0]?.message?.content || openai.text || openai.content || 'Sem resposta da IA';\nconst pergunta = $('Construtor Prompt').first().json.pergunta;\nconst chatId = $('Mensagem Inicial').first().json.message.from.id;\nconst agora = new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });\nconst respostaHtml = resposta.replace(/\\n/g, '<br>');\nconst html = `<div style=\"font-family:Arial,sans-serif;max-width:680px;margin:0 auto\">\n  <div style=\"background:#0D1B2E;padding:20px;border-radius:8px 8px 0 0\">\n    <h2 style=\"color:#E8622A;margin:0\">📊 Análise do Consumidor</h2>\n    <p style=\"color:#C8D8E8;margin:8px 0 0\">Tander Bootcamp - Aula 04</p>\n  </div>\n  <div style=\"background:#F2F5F9;padding:18px;border-left:4px solid #E8622A\">\n    <p style=\"color:#4A5568;font-size:14px\"><strong>Pergunta:</strong> ${pergunta}</p>\n  </div>\n  <div style=\"background:#FFFFFF;padding:20px;border:1px solid #D0D5DC\">\n    <p style=\"color:#1A202C;line-height:1.7\">${respostaHtml}</p>\n  </div>\n  <div style=\"background:#0D1B2E;padding:12px 20px;border-radius:0 0 8px 8px\">\n    <p style=\"color:#8899AA;font-size:12px;margin:0\">Gerado em ${agora} - Tander Bootcamp</p>\n  </div>\n</div>`;\nreturn [{ json: { resposta, pergunta, chatId, agora, html, subject: `Análise do Consumidor - ${agora}` } }];"
      },
